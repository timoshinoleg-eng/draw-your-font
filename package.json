{
  "name": "draw-your-font",
  "version": "0.2.0",
  "description": "Turn a photo of your handwriting into a real font (TTF/WOFF/WOFF2/OTF) - free, open source, no uploads. Base (potrace) and max (cubic-bezier + live font) quality tracks.",
  "author": "Oleg Timoshin (modifications); Danilo Znamerovszkij (original)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timoshinoleg-eng/draw-your-font.git"
  },
  "bin": {
    "draw-your-font": "src/cli.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/unit.js && node test/e2e.js",
    "test:unit": "node test/unit.js",
    "test:max": "node test/e2e-max.js",
    "test:live": "node test/e2e-live.js",
    "test:all": "node test/unit.js && node test/e2e.js && node test/e2e-max.js && node test/e2e-live.js",
    "build:demo": "esbuild site/demo.src.js --bundle --minify --format=iife --outfile=site/demo.js --external:node:fs --external:wawoff2 --log-level=error"
  },
  "keywords": [
    "font",
    "handwriting",
    "ttf",
    "woff2",
    "potrace",
    "claude-skill",
    "handwriting-font"
  ],
  "dependencies": {
    "pdfkit": "^0.15.0",
    "potrace": "^2.1.8",
    "sharp": "^0.33.4",
    "svg2ttf": "^6.0.3",
    "svgpath": "^2.6.0",
    "ttf2woff": "^3.0.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "esm-potrace-wasm": "^0.5.0",
    "opentype.js": "^1.3.4",
    "wrangler": "^4.86.0"
  }
}
